{
  "name": "@deepseek-ai/dsh-theme-wallpaper",
  "description": "主题与壁纸：macOS 观感主题 + 本地任意路径壁纸（静态图/动图/视频），壁纸暗化与面板半透明滑杆，失焦自动暂停；支持从 Wallpaper Engine 导出包(.mpkg)自动解出高清动态壁纸（专用导出文件夹 + 一键收桌面）",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
